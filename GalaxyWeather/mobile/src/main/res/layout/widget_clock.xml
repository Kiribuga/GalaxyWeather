<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_background" android:scaleType="fitXY" android:importantForAccessibility="no" />
<LinearLayout
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/widget_temperature" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="30sp" android:includeFontPadding="false" android:maxLines="1" />
            <TextView android:id="@+id/widget_city" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_condition" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#E0ECFF" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#D0E6FF" android:textSize="12sp" android:maxLines="1" android:includeFontPadding="false" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:orientation="vertical" android:gravity="end">
            <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:format24Hour="EEE, d MMM" android:format12Hour="EEE, d MMM"
                android:textColor="#E0ECFF" android:textSize="11sp" android:includeFontPadding="false" />
            <TextClock android:id="@+id/widget_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:format24Hour="HH:mm" android:format12Hour="HH:mm"
                android:textColor="#FFFFFF" android:textSize="32sp" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_details" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:visibility="gone">
        <TextView android:id="@+id/widget_metrics" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#E0ECFF" android:textSize="11sp" android:maxLines="1" android:includeFontPadding="false" android:layout_marginTop="4dp" />
        <LinearLayout android:id="@+id/widget_hours" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp" android:baselineAligned="false" />
        <TextView android:id="@+id/widget_source" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#C2D8F2" android:textSize="12sp" android:maxLines="1" android:includeFontPadding="false" android:layout_marginTop="4dp" />
    </LinearLayout>
</LinearLayout>

</FrameLayout>
